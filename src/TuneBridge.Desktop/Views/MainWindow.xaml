<Window x:Class="TuneBridge.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TuneBridge.Desktop.ViewModels"
        Title="TuneBridge"
        Height="720" Width="1180" MinHeight="560" MinWidth="900"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel LastChildFill="True" Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Top" Margin="20,28,20,24">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource AccentBrush}"
                                VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="♪" FontSize="14" Foreground="Black" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="TuneBridge" FontSize="20" FontWeight="Bold" Foreground="White"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="One library. Every platform." FontSize="11"
                               Foreground="{StaticResource TextMuted}" Margin="38,4,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <Button Content="  ↔  Transfer" Command="{Binding NavigateTransferCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentSection}" Value="Transfer">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Background" Value="#1A1A1A"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="  ◷  History" Command="{Binding NavigateHistoryCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentSection}" Value="History">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Background" Value="#1A1A1A"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="  ⚙  Settings" Command="{Binding NavigateSettingsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentSection}" Value="Settings">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Background" Value="#1A1A1A"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="20,0">
                    <TextBlock Text="{Binding AppVersion}" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                </StackPanel>

                <Border/>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Background="{StaticResource BgBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="28,18,28,12" BorderBrush="#1A1A1A" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding SectionTitle}" FontSize="24" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#222" CornerRadius="16" Padding="12,6" Margin="0,0,10,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#6A6A6A"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAuthenticated}" Value="True">
                                                    <Setter Property="Fill" Value="#1DB954"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding AuthStatusShort}" FontSize="12"
                                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Button Content="Connect Spotify" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ConnectSpotifyCommand}"
                                Visibility="{Binding ConnectButtonVisibility}" Padding="16,8"/>
                        <Button Content="Disconnect" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding DisconnectSpotifyCommand}"
                                Visibility="{Binding DisconnectButtonVisibility}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,20,28,24">
                <Grid>
                    <StackPanel Visibility="{Binding TransferSectionVisibility}">
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="SOURCE" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="40" Height="40" CornerRadius="20" Background="#1DB954"
                                                Margin="0,0,12,0">
                                            <TextBlock Text="S" FontWeight="Bold" FontSize="18" Foreground="Black"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Playlist file / Spotify" FontSize="16" FontWeight="Bold" Foreground="White"/>
                                            <TextBlock Text="{Binding SourceServiceSubtitle}" FontSize="12"
                                                       Foreground="{StaticResource TextSecondary}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Grid.Column="1" Text="→" FontSize="28" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center" Margin="16,0"/>

                            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="DESTINATION" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="40" Height="40" CornerRadius="20" Background="#1DB954"
                                                Margin="0,0,12,0">
                                            <TextBlock Text="S" FontWeight="Bold" FontSize="18" Foreground="Black"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Spotify" FontSize="16" FontWeight="Bold" Foreground="White"/>
                                            <TextBlock Text="Private playlist · your Spotify account"
                                                       FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Playlist" FontSize="14" FontWeight="SemiBold"
                                           Foreground="White" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding PlaylistUrl, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DarkTextBoxStyle}"
                                             ToolTip="Paste a Spotify playlist URL. Track lists require ownership or collaboration (API Feb 2026)."/>
                                    <Button Grid.Column="1" Content="Analyze" Margin="12,0,0,0"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding ImportCommand}"
                                            MinWidth="120"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Import file" Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding ImportFileCommand}" Margin="0,0,8,0"/>
                                    <Button Content="Export playlist" Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding ExportJsonCommand}"/>
                                    <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CancelCommand}" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Status}" FontSize="12" Margin="0,12,0,0"
                                           Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Visibility="{Binding BusyVisibility}" Margin="0,0,0,16"
                                Background="#1A1A1A" CornerRadius="8" Padding="16,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="●" Foreground="{StaticResource AccentBrush}" FontSize="14"
                                               Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Status}" Foreground="White" FontSize="13"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource TextSecondary}"
                                               FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}"
                                             Height="5" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Visibility="{Binding ResultsVisibility}">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding PlaylistNameDisplay}" FontSize="18" FontWeight="Bold"
                                                   Foreground="White"/>
                                        <TextBlock Text="{Binding ResultsSummary}" FontSize="13" Margin="0,4,0,0"
                                                   Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#1A3D2A" CornerRadius="12" Padding="10,4" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding MatchedCount, StringFormat=Matched: {0}}"
                                                       FontSize="11" Foreground="#1DB954" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border Background="#3D2E14" CornerRadius="12" Padding="10,4" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding AlternateVersionCount, StringFormat=Alt. versions: {0}}"
                                                       FontSize="11" Foreground="#F0B35A" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border Background="#3D2E14" CornerRadius="12" Padding="10,4" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding AmbiguousCount, StringFormat=Review: {0}}"
                                                       FontSize="11" Foreground="#F59B23" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border Background="#3D1418" CornerRadius="12" Padding="10,4" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding MissingCount, StringFormat=Missing: {0}}"
                                                       FontSize="11" Foreground="#E91429" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border Background="#3D2525" CornerRadius="12" Padding="10,4">
                                            <TextBlock Text="{Binding SearchErrorCount, StringFormat=Errors: {0}}"
                                                       FontSize="11" Foreground="#FF8A80" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <DataGrid ItemsSource="{Binding Results}" MaxHeight="360" HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Add" Width="48">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              IsEnabled="{Binding CanSelect}" HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="48"/>
                                        <DataGridTextColumn Header="Title" Binding="{Binding SourceTitle}" Width="*"/>
                                        <DataGridTextColumn Header="Artist" Binding="{Binding SourceArtist}" Width="*"/>
                                        <DataGridTextColumn Header="Match" Binding="{Binding MatchTitle}" Width="*"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="110"/>
                                        <DataGridTextColumn Header="Score" Binding="{Binding Score, StringFormat=P0}" Width="70"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border Margin="0,18,0,0" Background="#161616" CornerRadius="10" Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Transfer to destination"
                                                       FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                            <TextBlock Text="{Binding TransferHint}" FontSize="12" Margin="0,4,0,0"
                                                       Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Transfer matched"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding TransferCommand}"
                                                ToolTip="Creates a private Spotify playlist and adds only high-confidence matches."/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Visibility="{Binding EmptyStateVisibility}"
                                Style="{StaticResource CardStyle}" Padding="40" Margin="0,8,0,0">
                            <StackPanel HorizontalAlignment="Center" MaxWidth="420">
                                <TextBlock Text="Start a transfer" FontSize="20" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"
                                           FontSize="14" Foreground="{StaticResource TextSecondary}"
                                           Text="1. Connect Spotify (PKCE).&#10;2. Paste a Spotify playlist URL or import a JSON, CSV, M3U or M3U8 file.&#10;3. Analyze tracks and review matches.&#10;4. Transfer adds only high-confidence matches to a new private Spotify playlist."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding HistorySectionVisibility}">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Transfer history" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Saved locally on this device" FontSize="12"
                                               Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Clear history"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding ClearHistoryCommand}"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <DataGrid ItemsSource="{Binding History}" AutoGenerateColumns="False"
                                      IsReadOnly="True" MaxHeight="520" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Playlist" Binding="{Binding PlaylistName}" Width="*"/>
                                    <DataGridTextColumn Header="Date" Binding="{Binding Timestamp, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="150"/>
                                    <DataGridTextColumn Header="From" Binding="{Binding SourceProvider}" Width="90"/>
                                    <DataGridTextColumn Header="To" Binding="{Binding DestinationProvider}" Width="90"/>
                                    <DataGridTextColumn Header="Added" Binding="{Binding TransferredCount}" Width="70"/>
                                    <DataGridTextColumn Header="Skipped" Binding="{Binding SkippedCount}" Width="75"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                    <DataGridTextColumn Header="Destination URL" Binding="{Binding DestinationUrl}" Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding SettingsSectionVisibility}">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Spotify" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>
                                <TextBlock Text="{Binding AuthStatus}" FontSize="13"
                                           Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Connect Spotify" Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding ConnectSpotifyCommand}" Margin="0,0,10,0"/>
                                    <Button Content="Disconnect" Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding DisconnectSpotifyCommand}"/>
                                </StackPanel>
                                <TextBlock FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,14,0,0"
                                           TextWrapping="Wrap"
                                           Text="Set TUNEBRIDGE_SPOTIFY_CLIENT_ID (public Client ID). Optional: TUNEBRIDGE_SPOTIFY_REDIRECT_URI = http://127.0.0.1:43821/callback. No Client Secret required for PKCE."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Services" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#161616" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="Spotify" FontWeight="SemiBold" Foreground="White"/>
                                            <TextBlock Text="Read · search · match · transfer" FontSize="12"
                                                       Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="#161616" CornerRadius="8" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="Звук" FontWeight="SemiBold" Foreground="White"/>
                                            <TextBlock Text="File import/export route until a supported connector is available"
                                                       FontSize="12" Foreground="{StaticResource WarnBrush}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="About" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                                <TextBlock FontSize="13" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"
                                           Text="{Binding AboutText}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
