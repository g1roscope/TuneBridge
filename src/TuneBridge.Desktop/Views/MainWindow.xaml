<Window x:Class="TuneBridge.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TuneBridge 2.0" Height="640" Width="960"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="TuneBridge" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Text="One library. Every music platform." Foreground="{StaticResource TextSecondary}"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding PlaylistUrl, UpdateSourceTrigger=PropertyChanged}"
                     Height="36" VerticalContentAlignment="Center" Margin="0,0,8,0"
                     Background="{StaticResource CardBrush}" Foreground="{StaticResource TextPrimary}"
                     BorderBrush="#333"/>
            <ComboBox Grid.Column="1" Width="140" Height="36" Margin="0,0,8,0"
                      SelectedValue="{Binding Destination}" SelectedValuePath="Tag">
                <ComboBoxItem Content="Spotify" Tag="spotify" IsSelected="True"/>
                <ComboBoxItem Content="Звук [Exp.]" Tag="zvuk"/>
            </ComboBox>
            <Button Grid.Column="2" Content="Import & Match" Height="36" Width="140" Margin="0,0,8,0"
                    Command="{Binding ImportCommand}"
                    Background="{StaticResource AccentBrush}" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
            <Button Grid.Column="3" Content="Export" Height="36" Width="90"
                    Command="{Binding ExportJsonCommand}"
                    Background="{StaticResource CardBrush}" Foreground="{StaticResource TextPrimary}"/>
        </Grid>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Results}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False"
                  Background="{StaticResource CardBrush}" Foreground="{StaticResource TextPrimary}"
                  BorderBrush="#333" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" RowBackground="{StaticResource CardBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="40"/>
                <DataGridTextColumn Header="Source" Binding="{Binding SourceTitle}" Width="*"/>
                <DataGridTextColumn Header="Artist" Binding="{Binding SourceArtist}" Width="*"/>
                <DataGridTextColumn Header="Match" Binding="{Binding MatchTitle}" Width="*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                <DataGridTextColumn Header="Score" Binding="{Binding Score, StringFormat=P0}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Text="{Binding Status}" Margin="0,10,0,0"
                   Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
    </Grid>
</Window>
